# Preferred PostgreSQL connection string.
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Optional fallback when DATABASE_URL is not set.
PGHOST=localhost
PGPORT=5433
PGUSER=votion
PGPASSWORD=
PGDATABASE=votion_proxmox_db

# Required in production; generate with: openssl rand -hex 32
PROXMOX_CREDENTIALS_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Optional dedicated Support PIN pepper; TOKEN_SECRET is used when omitted.
SUPPORT_PIN_PEPPER=
