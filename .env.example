# Preferred PostgreSQL connection string.
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Optional fallback when DATABASE_URL is not set.
PGHOST=localhost
PGPORT=5433
PGUSER=votion
PGPASSWORD=
PGDATABASE=votion_proxmox_db

# Required in production; generate with: openssl rand -hex 32
PROXMOX_CREDENTIALS_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Optional dedicated Support PIN pepper; TOKEN_SECRET is used when omitted.
SUPPORT_PIN_PEPPER=

# Required session-signing secret; minimum 32 characters.
TOKEN_SECRET=

# Comma-separated exact browser origins allowed to send credentialed requests.
# Required in production; do not use a wildcard with credentials.
CORS_ORIGINS=https://panel.example.com

# Number of trusted reverse-proxy hops, or true only when all proxy hops are trusted.
TRUST_PROXY=false

# Per-IP/account API request ceiling over 15 minutes.
API_RATE_LIMIT_MAX=300

# Exact HTTPS hostnames permitted for non-Cloudflare reverse-DNS provider calls.
RDNS_PROVIDER_HOSTS=rdns.example.com
