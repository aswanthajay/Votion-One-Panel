    "@react-three/fiber": "^8.18.0",
    "@remix-run/react": "^2.17.5",
    "@tremor/react": "^3.18.7",
    "@types/multer": "^1.4.13",
    "busboy": "^1.6.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "framer-motion": "^13.1.0",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.344.0",
