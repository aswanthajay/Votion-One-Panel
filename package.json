    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
